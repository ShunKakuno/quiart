datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Quiz {
  id            Int @id @default(autoincrement())
  title         String
  tag           String
  level         String
  explanation   String
  categories    String[]
  correctQuizId String
  createdAt     DateTime  @default(now())
  deleted       String @default("0")
  articleId     Int?
  view          Int @default(0)

  choices       Choice[]
}

model Choice {
  id         Int   @id @default(autoincrement())
  quizId     Int
  selectId   String
  text       String
  selected   Int

  quiz   Quiz @relation(fields: [quizId], references: [id])
}

model Article {
  id         String   @id @default(cuid())
  qiitaId    String?
  content    String
  title      String
  tags       String[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
  deleted    String @default("0")
  view       Int @default(0)
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  sessions     AdminSession[] 
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  expiresAt DateTime

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Terms {
  id          Int @id @default(autoincrement())
  term        String
  description String
  category  String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  deleted     String @default("0")
  view        Int @default(0)
}
