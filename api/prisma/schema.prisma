generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
}

model Category {
  id           Int               @id @default(autoincrement())
  name         String            @unique
  articleLinks ArticleCategory[]
  quizLinks    QuizCategory[]
  termLinks    TermCategory[]
}

model TermCategory {
  termId     Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  term       Terms    @relation(fields: [termId], references: [id])

  @@id([termId, categoryId])
}

model Quiz {
  title         String
  level         String
  createdAt     DateTime       @default(now())
  correctQuizId String
  explanation   String
  deleted       String         @default("0")
  view          Int            @default(0)
  id            Int            @id @default(autoincrement())
  articleId     Int?
  choices       Choice[]
  quizLinks     QuizCategory[]
}

model QuizCategory {
  quizId     Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  quiz       Quiz     @relation(fields: [quizId], references: [id])

  @@id([quizId, categoryId])
}

model Choice {
  text     String
  selectId String
  selected Int    @default(0)
  id       Int    @id @default(autoincrement())
  quizId   Int
  quiz     Quiz   @relation(fields: [quizId], references: [id])
}

model Article {
  qiitaId      String?
  content      String
  title        String
  createdAt    DateTime          @default(now())
  deleted      String            @default("0")
  updatedAt    DateTime          @default(now())
  view         Int               @default(0)
  id           Int               @id @default(autoincrement())
  articleLinks ArticleCategory[]
}

model ArticleCategory {
  categoryId Int
  articleId  Int
  article    Article  @relation(fields: [articleId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([articleId, categoryId])
}

model Admin {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  expiresAt DateTime
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Terms {
  id              Int            @id @default(autoincrement())
  term            String
  description     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now())
  deleted         String         @default("0")
  view            Int            @default(0)
  term_normalized String?
  termLinks       TermCategory[]

  @@index([term_normalized(ops: raw("gin_trgm_ops"))], map: "idx_terms_trgm", type: Gin)
}
