datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Quiz {
  id            String    @id
  title         String
  tag           String
  level         String
  explanation   String
  categories    String[]
  correctQuizId String
  createdAt     DateTime  @default(now())
  deleted       String @default("0")

  choices       Choice[]
}

model Choice {
  id         String   @id @default(cuid())
  quizId     String
  selectId   String
  text       String
  selected      Int

  quiz   Quiz @relation(fields: [quizId], references: [id])
}

model Article {
  id         String   @id @default(cuid())
  qiitaId    String?
  content    String
  title      String
  tags       String[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
  deleted    String @default("0")
}
