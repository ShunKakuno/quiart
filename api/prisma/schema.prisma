datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Quiz {
  id            String    @id
  title         String
  tag           String
  level         String
  mistakeReason String
  choices       Choice[]
  categories    String[]
  createdAt     DateTime  @default(now())
}

model Choice {
  id         String   @id @default(cuid())
  quizId String
  text       String
  isCorrect  Boolean
  index      Int

  quiz   Quiz @relation(fields: [quizId], references: [id])

  @@unique([quizId, index])
}
